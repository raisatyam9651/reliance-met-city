# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

RewriteEngine On

# 301 Permanent Redirects for Deleted Blogs
RewriteRule ^who-is-the-owner-of-reliance-met-city(\.php)?$ https://reliancecityplots.in/blog/ [R=301,L]
RewriteRule ^what-is-the-plot-rate-in-reliance-met-city-jhajjar(\.php)?$ https://reliancecityplots.in/blog/ [R=301,L]
RewriteRule ^companies-in-reliance-met-city(\.php)?$ https://reliancecityplots.in/blog/ [R=301,L]
RewriteRule ^how-much-land-is-in-reliance-met-city(\.php)?$ https://reliancecityplots.in/blog/ [R=301,L]

# Rewrite Rules for Extensionless URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]
